{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.ozzysv.via-net-assigner",
  "name": "Via Net Assigner",
  "description": "Assign a selected pad/track net to subsequently selected vias, in the launching KiCad PCB Editor only.",
  "version": "1.0.6",
  "kicad_version": "10.0",
  "status": "stable",
  "runtime": {
    "type": "python",
    "min_version": "3.11"
  },
  "actions": [
    {
      "identifier": "assign_via_nets",
      "name": "Via Net Assigner",
      "description": "Copy a pad or track net onto vias",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "via_net_assigner.py",
      "icons-light": [
        "icon24.png",
        "icon32.png",
        "icon48.png",
        "icon64.png"
      ],
      "icons-dark": [
        "icon24.png",
        "icon32.png",
        "icon48.png",
        "icon64.png"
      ]
    }
  ]
}
